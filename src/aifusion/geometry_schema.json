{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-FUSION Geometry Instruction",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "units", "components"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "units": { "type": "string", "enum": ["mm", "cm", "m"] },
    "symmetry": { "type": "boolean" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primitive", "size", "position"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "primitive": { "type": "string", "enum": ["box", "cylinder", "sphere", "cone", "mesh_reference"] },
          "size": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
          "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
          "rotation_deg": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
          "parent_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
